# Copy to .env. Empty DATABASE_URL selects SQLite for development.
DATABASE_URL=
DATA_DIR=./data
APP_URL=http://localhost:3000
# Use your actual NGO contact for provider requests.
INGEST_USER_AGENT=KitabsLibrary/2.0 (contact: replace-with-your-email)
# Set for production behind HTTPS.
COOKIE_SECURE=false
# Optional full-text search. Without this, database text search remains available.
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
# Optional S3/MinIO storage. Without this, files use DATA_DIR/objects.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=kitabs
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional API integrations. Secrets stay on the server.
SHAMELA_API_KEY=
SHAMELA_MASTER_ENDPOINT=https://shamela.ws/api/master_patch
SHAMELA_BOOKS_ENDPOINT=https://shamela.ws/api/books
# Local metadata snapshot produced by the Shamela client or JSONL import.
SHAMELA_CATALOGUE_PATH=
# Turath sync uses only this selected set; it never crawls the entire site.
TURATH_BOOK_IDS=
HF_TOKEN=
HF_WAQFEYA_REPO=ieasybooks-org/waqfeya-library
HF_PROPHET_REPO=ieasybooks-org/prophet-mosque-library
ARCHIVE_QUERY=mediatype:texts AND language:ara
OPENITI_REPO=OpenITI/RELEASE
GITHUB_TOKEN=
# Optional approved live reference APIs; use providers' official credentials.
DORAR_API_TOKEN=
QURAN_CLIENT_ID=
QURAN_CLIENT_SECRET=
# Bound downloads. Start small.
MAX_DOWNLOAD_MB=100
DISCOVERY_LIMIT=50
